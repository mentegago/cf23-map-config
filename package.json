{
  "name": "cf23-data",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python scripts/publish_map_data.py && bun run scripts/remap.ts",
    "build:manual": "REFRESH_FANDOMS=false bun run build",
    "build:map": "python scripts/publish_map_data.py",
    "test:map": "python -m unittest discover -s scripts -p '*_test.py'",
    "snapshot:catalog": "bun run scripts/download-catalog.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
